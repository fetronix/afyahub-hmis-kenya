
.env
.env.*
!.env.example

node_modules/
dist/
build/
coverage/
.vite/
*.log

# Local secrets and credentials
firebase-applet-config.json

# Local backups made before patching a file — never commit these.
#
# *.bak alone was not enough: the repository also carried
#   App.tsx.backup-20261013-145411        (*.backup-*)
#   schema.ts.before-access-status-...    (*.before-*)
#   client.ts.validated-backup-...        (*-backup-*)
# which were untracked in 404caee and then still showed up as untracked
# files, one `git add .` away from coming back.
*.bak
*.orig
*.backup
*.backup-*
*.before-*
*-backup-*

# scratch files written by scripts/verify-dry-run.mjs
.verify-dry-run-*

# ============================================================
# Database dumps and backups — NEVER commit these
# ============================================================
#
# Four pg_dump files were committed before this rule existed (~1.1 MB,
# referencing `patients` and `patient_identifiers`). They have been removed
# from tracking. A dump is a full copy of patient data with none of the
# database's access control: it cannot be encrypted at rest by the database,
# cannot be audited, and cannot be un-disclosed once pushed.
#
# Back up to storage outside the repository. If a dump must live locally,
# this file keeps it out of commits.
*.dump
*.dump.*
*.sql.gz
*.sql.gz.*
*.pgdump
*.psql
backups/
local-backups/
