{
  "name": "jalicare-hmis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node build/server.js",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "db:clean": "tsx src/db/clean-database.ts",
    "db:migrate": "node scripts/run-script.mjs migrate",
    "db:migrate:drizzle": "drizzle-kit migrate",
    "db:status": "node scripts/run-script.mjs migration-status",
    "db:status:0009": "node scripts/run-script.mjs migration-status --expect-0009",
    "db:grant-inpatient-permissions": "tsx scripts/grant-inpatient-permissions.ts",
    "locations:migration": "tsx scripts/generate-location-migration.ts",
    "test": "vitest run --coverage",
    "test:docker": "node scripts/test-docker.mjs",
    "test:browser:synthetic": "node scripts/synthetic-browser-smoke.mjs",
    "db:status:all": "node scripts/run-script.mjs migration-status --expect-all",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:permissions": "node scripts/run-script.mjs seed-permissions",
    "build:server": "node scripts/build-server.mjs",
    "build:deploy": "npm run clean && npm run build && npm run build:server",
    "start:dev": "tsx server.ts",
    "db:preflight": "node scripts/run-script.mjs preflight",
    "db:migrate:dry": "node scripts/run-script.mjs migrate --dry-run",
    "db:seed:permissions:dry": "node scripts/run-script.mjs seed-permissions --dry-run",
    "typecheck": "tsc --noEmit",
    "verify:dry-run": "node scripts/verify-dry-run.mjs",
    "verify:deploy": "node scripts/verify-dry-run.mjs && npx vitest run src/tests/deployment.spec.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"server.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"server.ts\" \"*.{json,md}\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm test",
    "ci": "npm run typecheck && npm run lint && npm test && npm run test:coverage && npm run build:deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "uuid": "^11.1.1",
    "launch-editor": "^2.12.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
