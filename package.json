    "test:reporting": "tsx src/tests/reporting.test.ts",
    "test:pharmacy-batches": "tsx src/tests/pharmacy-batches.test.ts",
    "test:payments": "tsx src/tests/payments.test.ts",
    "test:claims": "tsx src/tests/claims.test.ts",
    "test": "npm run test:inpatient && npm run test:opd && npm run test:billing && npm run test:tariff-matching && npm run test:tariff-resolver && npm run test:ward-billing && npm run test:nursing && npm run test:reporting && npm run test:pharmacy-batches && npm run test:payments && npm run test:claims && npm run test:dha && npm run test:verification && npm run test:roles && npm run test:staff-roles && npm run test:design && npm run test:modules && npm run test:notifications && npm run test:compliance && npm run test:route-scope && npm run test:maternity && npm run test:postnatal && npm run test:security && npm run test:migrations && npm run test:field-encryption && npm run test:consent-allergy && npm run test:patient-portal && npm run test:round5 && npm run test:deploy && npm run test:auth-validation && npm run test:authorization && npm run test:subscription-access",
    "db:status:all": "node scripts/run-script.mjs migration-status --expect-all",
    "test:dha": "tsx src/tests/dha.test.ts",
    "test:verification": "tsx src/tests/professional-verification.test.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:security": "tsx src/tests/http-security.test.ts",
    "test:roles": "tsx src/tests/staff-role-catalogue.test.ts",
    "test:maternity": "tsx src/tests/maternity.test.ts",
    "test:postnatal": "tsx src/tests/postnatal-immunisation.test.ts",
    "db:seed:permissions": "node scripts/run-script.mjs seed-permissions",
    "test:opd": "tsx src/tests/opd-journey.test.ts",
    "test:staff-roles": "tsx src/tests/staff-roles.test.ts",
    "test:design": "tsx src/tests/design-tokens.test.ts",
    "test:modules": "tsx src/tests/facility-modules.test.ts",
    "test:notifications": "tsx src/tests/notifications.test.ts",
    "test:compliance": "tsx src/tests/dha-compliance.test.ts",
    "test:route-scope": "tsx src/tests/route-scope.test.ts",
    "test:field-encryption": "tsx src/tests/field-encryption.test.ts",
    "test:consent-allergy": "tsx src/tests/consent-allergy.test.ts",
    "test:patient-portal": "tsx src/tests/patient-portal.test.ts",
    "test:round5": "tsx src/tests/round5.test.ts",
    "build:server": "node scripts/build-server.mjs",
    "build:deploy": "npm run clean && npm run build && npm run build:server",
    "start:dev": "tsx server.ts",
    "db:preflight": "node scripts/run-script.mjs preflight",
    "db:migrate:dry": "node scripts/run-script.mjs migrate --dry-run",
    "db:seed:permissions:dry": "node scripts/run-script.mjs seed-permissions --dry-run",
    "typecheck": "tsc --noEmit",
    "test:deploy": "tsx src/tests/deployment.test.ts",
    "verify:dry-run": "node scripts/verify-dry-run.mjs",
    "verify:deploy": "node scripts/verify-dry-run.mjs && tsx src/tests/deployment.test.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"server.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"server.ts\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm test && npm run test:unit",
    "ci": "npm run typecheck && npm run lint && npm test && npm run test:coverage && npm run build:deploy",
    "test:auth-validation": "tsx src/tests/auth-validation.test.ts",
    "test:authorization": "tsx src/tests/authorization.test.ts",
    "test:subscription-access": "tsx src/tests/subscription-access.policy.test.ts",
    "test:auth-db": "tsx src/tests/auth-service.test.ts && tsx src/tests/authentication.test.ts"
