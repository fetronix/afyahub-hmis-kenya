
import { and, desc, eq, gt, isNull, or } from "drizzle-orm";
import { createHash, randomBytes, randomUUID } from "node:crypto";

import { db } from "../db";
import { hashPassword } from "../utils/password";
import {
  facilities,
  roles,
  userInvitations,
  tenants,
  users,
  userRoles,
  rolePermissions,
} from "../db/schema";

export class StaffInvitationError extends Error {
  constructor(
    message: string,
    public readonly statusCode = 400,
    public readonly code = "STAFF_INVITATION_ERROR",
  ) {
    super(message);
    this.name = "StaffInvitationError";
  }
}

export interface CreateStaffInvitationInput {
  tenantId: number;
  facilityId: number;
  email: string;
  fullName: string;
  phone?: string | null;
  designation?: string | null;
  roleId: number;
  invitedBy: string;
}

const INVITATION_LIFETIME_MS = 48 * 60 * 60 * 1000;

function normalizeEmail(email: string): string {
  return email.trim().toLowerCase();
}

function hashToken(token: string): string {
  return createHash("sha256").update(token).digest("hex");
}

function assertPositiveId(value: number, field: string): void {
  if (!Number.isSafeInteger(value) || value <= 0) {
    throw new StaffInvitationError(`Invalid ${field}.`, 400, "INVALID_INPUT");
  }
}

function assertTokenUsable(invitation: {
  expiresAt: Date;
  acceptedAt: Date | null;
  revokedAt: Date | null;
}): void {
  if (invitation.acceptedAt) {
    throw new StaffInvitationError(
      "This invitation has already been accepted.",
      409,
      "INVITATION_ALREADY_ACCEPTED",
    );
  }

  if (invitation.revokedAt) {
    throw new StaffInvitationError(
      "This invitation has been revoked.",
      410,
      "INVITATION_REVOKED",
    );
  }

  if (invitation.expiresAt.getTime() <= Date.now()) {
    throw new StaffInvitationError(
      "This invitation has expired.",
      410,
      "INVITATION_EXPIRED",
    );
  }
}

/**
 * Creates a staff invitation.
 *
 * The caller must obtain tenantId and facilityId from the
 * authenticated administrator's authorization context.
 */
export async function createStaffInvitation(
  input: CreateStaffInvitationInput,
) {
  assertPositiveId(input.tenantId, "tenant");
  assertPositiveId(input.facilityId, "facility");
  assertPositiveId(input.roleId, "role");

  const email = normalizeEmail(input.email);
  const fullName = input.fullName.trim();

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    throw new StaffInvitationError(
      "Enter a valid email address.",
      400,
      "INVALID_EMAIL",
    );
  }

  if (!fullName || fullName.length > 200) {
    throw new StaffInvitationError(
      "Full name is required and must not exceed 200 characters.",
      400,
      "INVALID_NAME",
    );
  }

  if (!input.invitedBy.trim()) {
    throw new StaffInvitationError(
      "The inviting administrator could not be identified.",
      401,
      "INVITER_REQUIRED",
    );
  }

  const [facility] = await db
    .select({
      id: facilities.id,
      tenantId: facilities.tenantId,
      isActive: facilities.isActive,
    })
    .from(facilities)
    .where(eq(facilities.id, input.facilityId))
    .limit(1);

  if (
    !facility ||
    !facility.isActive ||
    facility.tenantId !== input.tenantId
  ) {
    throw new StaffInvitationError(
      "The selected facility is unavailable in this tenant.",
      403,
      "FACILITY_SCOPE_DENIED",
    );
  }

  const [role] = await db
    .select({
      id: roles.id,
      tenantId: roles.tenantId,
      name: roles.name,
      isActive: roles.isActive,
    })
    .from(roles)
    .where(eq(roles.id, input.roleId))
    .limit(1);

  if (
    !role ||
    !role.isActive ||
    role.tenantId !== input.tenantId
  ) {
    throw new StaffInvitationError(
      "Choose an active role belonging to this tenant.",
      400,
      "INVALID_STAFF_ROLE",
    );
  }

  // Staff invitations must not be used to grant platform or
  // administrator privileges.
  if (
    role.name.trim().toUpperCase().includes("SUPER_ADMIN") ||
    role.name.trim().toUpperCase().includes("FACILITY_ADMIN") ||
    role.name.trim().toUpperCase().includes("TENANT_ADMIN")
  ) {
    throw new StaffInvitationError(
      "This role cannot be assigned through staff invitations.",
      403,
      "ROLE_NOT_ASSIGNABLE",
    );
  }

  const rawToken = randomBytes(32).toString("base64url");
  const expiresAt = new Date(Date.now() + INVITATION_LIFETIME_MS);

  const [created] = await db
    .insert(userInvitations)
    .values({
      tenantId: input.tenantId,
      facilityId: input.facilityId,
      email,
      fullName,
      phone: input.phone?.trim() || null,
      designation: input.designation?.trim() || null,
      roleId: input.roleId,
      invitationTokenHash: hashToken(rawToken),
      expiresAt,
      invitedBy: input.invitedBy,
    })
    .returning({
      id: userInvitations.id,
      email: userInvitations.email,
      fullName: userInvitations.fullName,
      facilityId: userInvitations.facilityId,
      roleId: userInvitations.roleId,
      expiresAt: userInvitations.expiresAt,
      createdAt: userInvitations.createdAt,
    });

  if (!created) {
    throw new StaffInvitationError(
      "The invitation could not be created.",
      500,
      "INVITATION_CREATE_FAILED",
    );
  }

  // Return the raw token only once. Store only its hash.
  return {
    invitation: created,
    token: rawToken,
  };
}

/**
 * Validates a token without returning its stored hash.
 */
export async function validateStaffInvitation(token: string) {
  if (!token || token.length < 20 || token.length > 200) {
    throw new StaffInvitationError(
      "The invitation link is invalid.",
      400,
      "INVALID_INVITATION_TOKEN",
    );
  }

  const [invitation] = await db
    .select({
      id: userInvitations.id,
      tenantId: userInvitations.tenantId,
      facilityId: userInvitations.facilityId,
      email: userInvitations.email,
      fullName: userInvitations.fullName,
      designation: userInvitations.designation,
      roleName: roles.name,
      expiresAt: userInvitations.expiresAt,
      acceptedAt: userInvitations.acceptedAt,
      revokedAt: userInvitations.revokedAt,
    })
    .from(userInvitations)
    .innerJoin(roles, eq(userInvitations.roleId, roles.id))
    .where(
      eq(userInvitations.invitationTokenHash, hashToken(token)),
    )
    .limit(1);

  if (!invitation) {
    throw new StaffInvitationError(
      "The invitation link is invalid.",
      404,
      "INVITATION_NOT_FOUND",
    );
  }

  assertTokenUsable(invitation);

  return {
    id: invitation.id,
    email: invitation.email,
    fullName: invitation.fullName,
    designation: invitation.designation,
    roleName: invitation.roleName,
    expiresAt: invitation.expiresAt,
  };
}

/**
 * Lists invitations only for the specified authorized tenant/facility.
 */
export async function listStaffInvitations(
  tenantId: number,
  facilityId: number,
) {
  assertPositiveId(tenantId, "tenant");
  assertPositiveId(facilityId, "facility");

  const rows = await db
    .select({
      id: userInvitations.id,
      email: userInvitations.email,
      fullName: userInvitations.fullName,
      designation: userInvitations.designation,
      roleId: userInvitations.roleId,
      roleName: roles.name,
      expiresAt: userInvitations.expiresAt,
      acceptedAt: userInvitations.acceptedAt,
      revokedAt: userInvitations.revokedAt,
      createdAt: userInvitations.createdAt,
      invitedBy: userInvitations.invitedBy,
    })
    .from(userInvitations)
    .innerJoin(roles, eq(userInvitations.roleId, roles.id))
    .where(
      and(
        eq(userInvitations.tenantId, tenantId),
        eq(userInvitations.facilityId, facilityId),
      ),
    )
    .orderBy(desc(userInvitations.createdAt));

  return rows.map((row) => ({
    ...row,
    status: row.acceptedAt
      ? "accepted"
      : row.revokedAt
        ? "revoked"
        : row.expiresAt.getTime() <= Date.now()
          ? "expired"
          : "pending",
  }));
}

/**
 * Revokes an unused invitation in the authorized facility.
 */
export async function revokeStaffInvitation(
  invitationId: number,
  tenantId: number,
  facilityId: number,
) {
  assertPositiveId(invitationId, "invitation");
  assertPositiveId(tenantId, "tenant");
  assertPositiveId(facilityId, "facility");

  const [invitation] = await db
    .select({
      id: userInvitations.id,
      expiresAt: userInvitations.expiresAt,
      acceptedAt: userInvitations.acceptedAt,
      revokedAt: userInvitations.revokedAt,
    })
    .from(userInvitations)
    .where(
      and(
        eq(userInvitations.id, invitationId),
        eq(userInvitations.tenantId, tenantId),
        eq(userInvitations.facilityId, facilityId),
      ),
    )
    .limit(1);

  if (!invitation) {
    throw new StaffInvitationError(
      "Invitation not found in this facility.",
      404,
      "INVITATION_NOT_FOUND",
    );
  }

  if (invitation.acceptedAt) {
    throw new StaffInvitationError(
      "An accepted invitation cannot be revoked.",
      409,
      "INVITATION_ALREADY_ACCEPTED",
    );
  }

  if (invitation.revokedAt) {
    return { id: invitation.id, revoked: true };
  }

  await db
    .update(userInvitations)
    .set({ revokedAt: new Date() })
    .where(
      and(
        eq(userInvitations.id, invitationId),
        eq(userInvitations.tenantId, tenantId),
        eq(userInvitations.facilityId, facilityId),
        isNull(userInvitations.acceptedAt),
        isNull(userInvitations.revokedAt),
      ),
    );

  return { id: invitation.id, revoked: true };
}

// Accept a staff invitation and create the account atomically.
// The raw invitation token is never stored in the database.
export async function acceptStaffInvitation(input: {
  token: string;
  username: string;
  password: string;
}) {
  const token = typeof input.token === "string" ? input.token.trim() : "";
  const username =
    typeof input.username === "string"
      ? input.username.trim().toLowerCase()
      : "";
  const password = typeof input.password === "string" ? input.password : "";

  if (!token || token.length < 20 || token.length > 200) {
    throw new StaffInvitationError(
      "The invitation link is invalid.",
      400,
      "INVALID_INVITATION_TOKEN",
    );
  }

  if (!/^[a-z0-9][a-z0-9._-]{2,39}$/.test(username)) {
    throw new StaffInvitationError(
      "Username must be 3–40 characters and use letters, numbers, dots, underscores or hyphens.",
      400,
      "INVALID_USERNAME",
    );
  }

  if (password.length < 12 || password.length > 256) {
    throw new StaffInvitationError(
      "Password must be at least 12 characters long.",
      400,
      "INVALID_PASSWORD",
    );
  }

  const tokenHash = hashToken(token);

  const [initialInvitation] = await db
    .select({
      id: userInvitations.id,
      expiresAt: userInvitations.expiresAt,
      acceptedAt: userInvitations.acceptedAt,
      revokedAt: userInvitations.revokedAt,
    })
    .from(userInvitations)
    .where(eq(userInvitations.invitationTokenHash, tokenHash))
    .limit(1);

  if (!initialInvitation) {
    throw new StaffInvitationError(
      "The invitation link is invalid.",
      404,
      "INVITATION_NOT_FOUND",
    );
  }

  assertTokenUsable(initialInvitation);

  const passwordHash = await hashPassword(password);
  const now = new Date();

  try {
    return await db.transaction(async (tx) => {
      const [invitation] = await tx
        .select()
        .from(userInvitations)
        .where(eq(userInvitations.invitationTokenHash, tokenHash))
        .limit(1)
        .for("update");

      if (!invitation) {
        throw new StaffInvitationError(
          "The invitation link is invalid.",
          404,
          "INVITATION_NOT_FOUND",
        );
      }

      assertTokenUsable(invitation);

      const [facility] = await tx
        .select({
          id: facilities.id,
          tenantId: facilities.tenantId,
          isActive: facilities.isActive,
        })
        .from(facilities)
        .where(eq(facilities.id, invitation.facilityId))
        .limit(1);

      if (
        !facility ||
        !facility.isActive ||
        facility.tenantId !== invitation.tenantId
      ) {
        throw new StaffInvitationError(
          "The facility associated with this invitation is unavailable.",
          409,
          "FACILITY_UNAVAILABLE",
        );
      }

      const [tenant] = await tx
        .select({
          id: tenants.id,
          isActive: tenants.isActive,
        })
        .from(tenants)
        .where(eq(tenants.id, invitation.tenantId))
        .limit(1);

      if (!tenant || !tenant.isActive) {
        throw new StaffInvitationError(
          "The organization associated with this invitation is unavailable.",
          409,
          "TENANT_UNAVAILABLE",
        );
      }

      const [existingUser] = await tx
        .select({
          id: users.id,
          email: users.email,
          username: users.username,
        })
        .from(users)
        .where(
          or(
            eq(users.email, invitation.email.toLowerCase()),
            eq(users.username, username),
          ),
        )
        .limit(1);

      if (existingUser) {
        const emailConflict =
          existingUser.email.toLowerCase() ===
          invitation.email.toLowerCase();

        throw new StaffInvitationError(
          emailConflict
            ? "An account already exists for this invitation email."
            : "This username is already taken.",
          409,
          "ACCOUNT_CONFLICT",
        );
      }

      const [role] = await tx
        .select({
          id: roles.id,
          name: roles.name,
          tenantId: roles.tenantId,
          isActive: roles.isActive,
        })
        .from(roles)
        .where(
          and(
            eq(roles.id, invitation.roleId),
            eq(roles.tenantId, invitation.tenantId),
            eq(roles.isActive, true),
          ),
        )
        .limit(1);

      if (!role) {
        throw new StaffInvitationError(
          "The invited role is no longer available. Contact your facility administrator.",
          409,
          "ROLE_UNAVAILABLE",
        );
      }

      const normalizedRoleName = role.name.trim().toUpperCase();
      if (
        normalizedRoleName.includes("SUPER_ADMIN") ||
        normalizedRoleName.includes("PLATFORM_ADMIN") ||
        normalizedRoleName.includes("FACILITY_ADMIN") ||
        normalizedRoleName.includes("TENANT_ADMIN")
      ) {
        throw new StaffInvitationError(
          "This role cannot be assigned through a staff invitation.",
          403,
          "ROLE_NOT_ASSIGNABLE",
        );
      }

      const [permission] = await tx
        .select({ id: rolePermissions.id })
        .from(rolePermissions)
        .where(eq(rolePermissions.roleId, role.id))
        .limit(1);

      if (!permission) {
        throw new StaffInvitationError(
          "The invited role has no permissions configured. Contact the platform administrator.",
          409,
          "ROLE_PERMISSIONS_NOT_CONFIGURED",
        );
      }

      const [newUser] = await tx
        .insert(users)
        .values({
          uid: `usr_${randomUUID()}`,
          tenantId: invitation.tenantId,
          facilityId: invitation.facilityId,
          username,
          email: invitation.email.toLowerCase(),
          emailVerifiedAt: now,
          fullName: invitation.fullName,
          phone: invitation.phone,
          designation: invitation.designation,
          passwordHash,
          passwordChangedAt: now,
          mustChangePassword: false,
          accountStatus: "ACTIVE",
          failedLoginAttempts: 0,
          mfaEnabled: false,
          mfaRequired: false,
          securityVersion: 1,
          isActive: true,
        })
        .returning({
          id: users.id,
          uid: users.uid,
          username: users.username,
          email: users.email,
          fullName: users.fullName,
          tenantId: users.tenantId,
          facilityId: users.facilityId,
        });

      if (!newUser) {
        throw new Error("Staff account creation failed.");
      }

      await tx.insert(userRoles).values({
        userId: newUser.id,
        roleId: role.id,
        assignedBy: invitation.invitedBy,
        isActive: true,
      });

      const acceptedRows = await tx
        .update(userInvitations)
        .set({
          acceptedAt: now,
          acceptedUserId: newUser.id,
        })
        .where(
          and(
            eq(userInvitations.id, invitation.id),
            isNull(userInvitations.acceptedAt),
            isNull(userInvitations.revokedAt),
            gt(userInvitations.expiresAt, now),
          ),
        )
        .returning({ id: userInvitations.id });

      if (acceptedRows.length !== 1) {
        throw new StaffInvitationError(
          "This invitation is no longer valid. Request a new invitation.",
          409,
          "INVITATION_NO_LONGER_VALID",
        );
      }

      return {
        success: true,
        user: newUser,
      };
    });
  } catch (error) {
    if (error instanceof StaffInvitationError) {
      throw error;
    }

    // Do not leak database details or credential-related data.
    console.error("Staff invitation acceptance failed:", error);
    throw new StaffInvitationError(
      "The staff account could not be created. Check that the email and username are unique, then try again.",
      409,
      "STAFF_ACCOUNT_CREATION_FAILED",
    );
  }
}


// Returns only active tenant roles that are safe to assign through staff invitations.
// The create/accept service performs its own authorization and permission checks.
export async function listAssignableStaffRoles(tenantId: number) {
  assertPositiveId(tenantId, "tenant");

  const rows = await db
    .select({
      id: roles.id,
      name: roles.name,
      description: roles.description,
    })
    .from(roles)
    .where(
      and(
        eq(roles.tenantId, tenantId),
        eq(roles.isActive, true),
      ),
    )
    .orderBy(roles.name);

  return rows.filter(
    (role) =>
      !/(SUPER[_ ]?ADMIN|PLATFORM[_ ]?ADMIN|FACILITY[_ ]?ADMIN|TENANT[_ ]?ADMIN)/i.test(
        role.name,
      ),
  );
}