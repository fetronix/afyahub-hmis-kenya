# Files the image must not carry.
#
# Reason to care beyond size: a secret copied into a layer is in that layer
# forever, even if a later instruction deletes the file. `.env` is excluded so
# it cannot reach the build stage at all.

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.netrc
.npmrc

# Dependencies and build output — reinstalled and rebuilt inside the image
node_modules/
dist/
build/
coverage/
.vite/

# Version control, tests, docs, deployment helpers
.git/
.gitignore
.github/
.lintstagedrc*
.husky/
src/tests/
docs/
.local/
local-backups/
deploy/
*.md
!README.md

# Logs, OS noise, editor state
*.log
logs/
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Databases and dumps — the image never contains data
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
*.sql.lz4
*.sql.br
*.sql.zip
*.dump
*.dump.*
*.pgdump
*.pgdump.*
*.psql
*.psql.*
*.bak
*.sqlite
*.sqlite.gz
*.sqlite.bz2
*.sqlite.xz
*.sqlite.zst
*.sqlite.lz4
*.sqlite.br
*.sqlite.zip
*.sqlite3
*.sqlite3.gz
*.sqlite3.bz2
*.sqlite3.xz
*.sqlite3.zst
*.sqlite3.lz4
*.sqlite3.br
*.sqlite3.zip
*.db
*.db.gz
*.db.bz2
*.db.xz
*.db.zst
*.db.lz4
*.db.br
*.db.zip
*.bak.*
dumps/
backups/
# Nested compression/encryption extensions (e.g. .sql.gz.gpg).
*.sql.gz.*
*.sql.bz2.*
*.sql.xz.*
*.sql.zst.*
*.sql.lz4.*
*.sql.br.*
*.sql.zip.*
*.db.gz.*
*.db.bz2.*
*.db.xz.*
*.db.zst.*
*.db.lz4.*
*.db.br.*
*.db.zip.*
*.sqlite.gz.*
*.sqlite.bz2.*
*.sqlite.xz.*
*.sqlite.zst.*
*.sqlite.lz4.*
*.sqlite.br.*
*.sqlite.zip.*
*.sqlite3.gz.*
*.sqlite3.bz2.*
*.sqlite3.xz.*
*.sqlite3.zst.*
*.sqlite3.lz4.*
*.sqlite3.br.*
*.sqlite3.zip.*
