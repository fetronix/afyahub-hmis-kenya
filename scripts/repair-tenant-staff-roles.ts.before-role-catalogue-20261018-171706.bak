import { pool } from "../src/db/index.ts";

const APPLY = process.argv.includes("--apply");
const TARGET_TENANTS = [7, 8];

const STAFF_ROLES = [
  {
    name: "BILLING_CLERK",
    description: "Handles billing and payment records.",
    permissions: [
      "billing.create", "billing.payments.record", "billing.read",
      "billing.update", "patients.read",
    ],
  },
  {
    name: "DOCTOR",
    description: "Provides clinical care and manages clinical records.",
    permissions: [
      "appointments.read", "clinical.create", "clinical.read",
      "clinical.update", "inpatient.read", "patients.read",
    ],
  },
  {
    name: "INVENTORY_OFFICER",
    description: "Manages inventory and procurement activities.",
    permissions: [
      "inventory.manage", "inventory.read",
      "procurement.create", "procurement.read",
    ],
  },
  {
    name: "LABORATORY_TECHNICIAN",
    description: "Handles laboratory orders and results entry.",
    permissions: [
      "laboratory.orders.create", "laboratory.read",
      "laboratory.results.enter", "patients.read",
    ],
  },
  {
    name: "NURSE",
    description: "Provides nursing care and accesses clinical records.",
    permissions: [
      "clinical.create", "clinical.read", "inpatient.read", "patients.read",
    ],
  },
  {
    name: "PHARMACIST",
    description: "Handles pharmacy dispensing and pharmacy records.",
    permissions: [
      "patients.read", "pharmacy.dispense", "pharmacy.read",
    ],
  },
  {
    name: "RECEPTIONIST",
    description: "Handles patient registration and appointments.",
    permissions: [
      "appointments.create", "appointments.read", "appointments.update",
      "patients.create", "patients.read",
    ],
  },
];

async function main() {
  const client = await pool.connect();

  try {
    await client.query("BEGIN");

    const tenantResult = await client.query(
      `SELECT id, name FROM tenants WHERE id = ANY($1::int[]) ORDER BY id`,
      [TARGET_TENANTS],
    );

    const foundIds = new Set(
      tenantResult.rows.map((row: { id: number }) => Number(row.id)),
    );
    const missingTenants = TARGET_TENANTS.filter((id) => !foundIds.has(id));

    if (missingTenants.length) {
      throw new Error(
        `Aborting: target tenant IDs not found: ${missingTenants.join(", ")}`,
      );
    }

    console.log(APPLY ? "\nAPPLY MODE" : "\nDRY-RUN MODE — no changes will be committed");
    console.table(tenantResult.rows);

    const allCodes = [
      ...new Set(STAFF_ROLES.flatMap((role) => role.permissions)),
    ];

    const permissionResult = await client.query(
      `SELECT id, code FROM permissions WHERE code = ANY($1::text[])`,
      [allCodes],
    );

    const permissionIds = new Map<string, number>(
      permissionResult.rows.map(
        (row: { id: number; code: string }) => [row.code, Number(row.id)],
      ),
    );

    const missingCodes = allCodes.filter((code) => !permissionIds.has(code));
    if (missingCodes.length) {
      throw new Error(
        `Aborting: required permission codes are missing: ${missingCodes.join(", ")}`,
      );
    }

    let rolesCreated = 0;
    let linksAdded = 0;

    for (const tenant of tenantResult.rows) {
      console.log(`\nTenant ${tenant.id}: ${tenant.name}`);

      for (const role of STAFF_ROLES) {
        let roleId: number;
        const existing = await client.query(
          `SELECT id, is_active FROM roles
           WHERE tenant_id = $1 AND name = $2`,
          [tenant.id, role.name],
        );

        if (existing.rowCount) {
          roleId = Number(existing.rows[0].id);
          console.log(
            `  Existing role: ${role.name} (active: ${existing.rows[0].is_active})`,
          );
        } else {
          console.log(`  Missing role: ${role.name}`);
          if (APPLY) {
            const inserted = await client.query(
              `INSERT INTO roles
                 (tenant_id, name, description, is_system, is_active)
               VALUES ($1, $2, $3, false, true)
               ON CONFLICT (tenant_id, name) DO NOTHING
               RETURNING id`,
              [tenant.id, role.name, role.description],
            );

            if (inserted.rowCount) {
              roleId = Number(inserted.rows[0].id);
              rolesCreated++;
            } else {
              const reread = await client.query(
                `SELECT id FROM roles WHERE tenant_id = $1 AND name = $2`,
                [tenant.id, role.name],
              );
              if (!reread.rowCount) {
                throw new Error(`Could not resolve role ${role.name} for tenant ${tenant.id}`);
              }
              roleId = Number(reread.rows[0].id);
            }
          } else {
            continue;
          }
        }

        for (const code of role.permissions) {
          const permissionId = permissionIds.get(code)!;

          if (!APPLY) {
            const link = await client.query(
              `SELECT 1 FROM role_permissions
               WHERE role_id = $1 AND permission_id = $2`,
              [roleId, permissionId],
            );
            if (!link.rowCount) {
              console.log(`    Missing permission link: ${code}`);
            }
            continue;
          }

          const insertedLink = await client.query(
            `INSERT INTO role_permissions (role_id, permission_id)
             VALUES ($1, $2)
             ON CONFLICT (role_id, permission_id) DO NOTHING
             RETURNING id`,
            [roleId, permissionId],
          );
          linksAdded += insertedLink.rowCount ?? 0;
        }
      }
    }

    if (APPLY) {
      await client.query("COMMIT");
      console.log(`\nCommitted. New roles: ${rolesCreated}; new permission links: ${linksAdded}`);
    } else {
      await client.query("ROLLBACK");
      console.log("\nDry run finished. Database changes rolled back.");
      console.log("If the plan is correct, rerun with --apply.");
    }
  } catch (error) {
    await client.query("ROLLBACK");
    throw error;
  } finally {
    client.release();
    await pool.end();
  }
}

main().catch((error) => {
  console.error("Staff role repair failed:", error);
  process.exitCode = 1;
});
