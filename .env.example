ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_USERNAME=
APP_BASE_URL=
DEFAULT_TIMEZONE=
SQL_ADMIN_PASSWORD=
SQL_ADMIN_USER=
SQL_DB_NAME=
SQL_HOST=
SQL_PORT=
TZ=

# ============================================================
# DHA / AfyaConnect (SHA)
# ============================================================
#
# DHA_MODE decides where a request goes:
#
#   mock        Deterministic local fixtures. Nothing leaves the
#               process and every result is marked simulated. Default.
#   sandbox     Real HTTPS calls to the DHA UAT gateway, using the
#               credentials issued after the application is approved.
#   production  Live. Refuses to run unless DHA_ALLOW_PRODUCTION=true
#               AND DHA_BASE_URL is set. Off by default; do not turn it
#               on before go-live approval.
#
# No credentials are required in mock mode. Sandbox requires
# DHA_CLIENT_ID, DHA_CLIENT_SECRET and DHA_FACILITY_CODE.
#
# Never commit real values. Set them in the host's environment panel.
DHA_MODE=mock
DHA_BASE_URL=
DHA_CLIENT_ID=
DHA_CLIENT_SECRET=
DHA_FACILITY_CODE=
DHA_TIMEOUT_MS=15000
DHA_MAX_RETRIES=2
DHA_ALLOW_PRODUCTION=false
