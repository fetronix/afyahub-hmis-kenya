ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_USERNAME=
# The installation's public address. Staff invitation links and CORS use it.
# Development: http://localhost:3000
APP_BASE_URL=
# The patient portal's public address. Optional: when empty the portal link
# uses APP_BASE_URL, and failing that the origin of the request that created
# the invitation. The portal is served by this same Express app, so a separate
# value is only needed when a proxy publishes it on another host.
PATIENT_PORTAL_URL=
DEFAULT_TIMEZONE=
SQL_ADMIN_PASSWORD=
SQL_ADMIN_USER=
SQL_DB_NAME=
SQL_HOST=
SQL_PORT=
# TLS to PostgreSQL. Leave false only when the database is on the same host.
SQL_SSL=false
# Keep this true: a TLS connection that accepts any certificate is not authenticated.
SQL_SSL_REJECT_UNAUTHORIZED=true
TZ=

# ============================================================
# DHA / AfyaConnect (SHA)
# ============================================================
#
# DHA_MODE decides where a request goes:
#
#   mock        Deterministic local fixtures. Nothing leaves the
#               process and every result is marked simulated. Default.
#   sandbox     Real HTTPS calls to the DHA UAT gateway, using the
#               credentials issued after the application is approved.
#   production  Live. Refuses to run unless DHA_ALLOW_PRODUCTION=true
#               AND DHA_BASE_URL is set. Off by default; do not turn it
#               on before go-live approval.
#
# No credentials are required in mock mode. Sandbox requires
# DHA_CLIENT_ID, DHA_CLIENT_SECRET and DHA_FACILITY_CODE.
#
# Never commit real values. Set them in the host's environment panel.
DHA_MODE=mock
DHA_BASE_URL=
DHA_CLIENT_ID=
DHA_CLIENT_SECRET=
DHA_FACILITY_CODE=
DHA_TIMEOUT_MS=15000
DHA_MAX_RETRIES=2
DHA_ALLOW_PRODUCTION=false

# ============================================================
# ENCRYPTION AT REST  (required)
# ============================================================
#
# FIELD_ENCRYPTION_KEY encrypts patient identifiers and insurance fields at
# rest. The application refuses to start without it.
#
# Generate a fresh key per installation:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 32 random bytes, base64 encoded (44 characters). Treat it as a
# credential:
#   - never commit it, never paste it into a ticket or a chat;
#   - store it in the host's environment panel, not in a file in the repo;
#   - LOSING IT LOSES THE DATA. Values encrypted with it cannot be
#     recovered without it. Keep it in the password manager alongside the
#     database password and the backup passphrase.
#   - Changing it does not re-encrypt existing values. Rotating the key is
#     a data migration, not a config edit.
FIELD_ENCRYPTION_KEY=

# ============================================================
# RUNTIME
# ============================================================
#
# NODE_ENV: development | test | production.
#   In production the app refuses to start with default or missing
#   secrets, and localhost is no longer allowed as a CORS origin.
NODE_ENV=development

# PORT the HTTP server listens on. cPanel/Passenger and every PaaS supply
# this; locally, 3000 matches the Vite dev server's expectations.
PORT=3000

# HOST to bind. 0.0.0.0 inside a container (the default), 127.0.0.1 if
# you want the process reachable only through a local proxy.
HOST=0.0.0.0

# Where the built SPA (index.html + assets) lives. Empty means the
# default, dist/, resolved from the application root.
STATIC_DIR=

# Where the migration journal and .sql files live. Empty means drizzle/.
# Only change this for a deployment layout that moves them.
MIGRATIONS_DIR=

# ============================================================
# LOGGING  (optional, but read in production)
# ============================================================
#
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent.
#   Empty means info in production and debug elsewhere. Raise it to
#   debug only while diagnosing; debug lines are verbose.
LOG_LEVEL=

# LOG_PSEUDONYM_KEY salts the short reference used when a log line has
#   to name a patient. Optional, but without it the logger falls back to
#   FIELD_ENCRYPTION_KEY and then to a fixed development salt, which
#   means the same patient gets a different reference on every
#   installation and the same reference on every development machine.
#   Set it in production. Changing it does not expose old records: the
#   references were never reversible, they just stop matching.
LOG_PSEUDONYM_KEY=

# ============================================================
# BUILD AND DEVELOPMENT TOOLING
# ============================================================
#
# These affect `npm run dev` and `npm run build`, not the running server.
# None of them is needed in production.

# BUILD_TARGET selects how the server bundle is produced:
#   node    build/server.js, run with `node` (cPanel, Docker)
# Vite reads it at build time; leave it empty for the default.
BUILD_TARGET=

# VITE_ALLOWED_HOSTS adds hostnames the Vite dev server will answer.
# Comma separated. Needed when developing behind a tunnel or a preview
# proxy; never set in production.
VITE_ALLOWED_HOSTS=

# DISABLE_HMR=true turns off hot reload and file watching in `npm run dev`.
# Useful on a machine where file watching exhausts inotify limits.
DISABLE_HMR=false

# ============================================================
# HTTP SECURITY
# ============================================================
#
# TRUST_PROXY: set to true only when the app runs behind a reverse
# proxy (nginx, cPanel, Cloudflare). Rate limiting keys on the client
# IP; without this every request looks like it came from the proxy and
# one busy client can lock out the whole facility.
TRUST_PROXY=false

# Extra browser origins allowed to call the API, comma separated.
# The deployment's own APP_BASE_URL is always allowed. Localhost is
# allowed automatically unless NODE_ENV=production.
CORS_ALLOWED_ORIGINS=

# ============================================================
# TEST HARNESS  (development and CI only)
# ============================================================
#
# Read by src/tests/vitest/support/db.ts. Never read by the server.
#
# JALICARE_DB_AVAILABLE=1 tells the Vitest database specs that a
#   PostgreSQL instance is reachable, so they run instead of skipping.
# JALICARE_REQUIRE_DB=1 turns "database was skipped" into a failure.
#   CI sets this so a broken service container cannot pass quietly.
#
# Leave both unset for ordinary development. `npm test` (the legacy
# suites) does not read either of them and needs no database.
JALICARE_DB_AVAILABLE=
JALICARE_REQUIRE_DB=
